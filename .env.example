# Copy to .env (in this folder, or in the folder one level above it) and fill in locally.
# Never commit .env.

# REQUIRED: the Portkey gateway key used for the gpt-6-luna model.
# This is the only setting the app needs; it runs on the bundled sample mailbox.
PORTKEY_API_KEY=your_portkey_api_key_here

# OPTIONAL: a read-only IMAP inbox ("Connect inbox" panel). Leave these commented out
# to use only the sample mailbox. Use an app password, not your main password.
# The app never sends, moves, deletes or marks mail as read, and never stores or logs these.
# IMAP_HOST=imap.example.org
# IMAP_USER=you@example.org
# IMAP_APP_PASSWORD=
# IMAP_PORT=993
# IMAP_FOLDER=INBOX
